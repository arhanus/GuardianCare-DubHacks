{
  "name": "guardiancare",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "expo": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.59.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "start:phone": "expo start --go --tunnel --clear",
    "build:web": "expo export --platform web",
    "start:lan": "expo start --go --lan --clear",
    "build:native": "expo export --platform android --platform ios"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
