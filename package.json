{
  "name": "guardiancare",
  "private": true,
  "version": "0.1.0",
  "description": "GuardianCare - screenless smart wristband + nurse mobile app (DubHacks 2026)",
  "workspaces": [
    "apps/mobile",
    "apps/api",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "bash scripts/dev-all.sh",
    "dev:mobile": "npm run start -w @guardiancare/mobile",
    "dev:api": "npm run dev -w @guardiancare/api",
    "build:api": "npm run build -w @guardiancare/api",
    "start:api": "npm run start -w @guardiancare/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
