NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Supabase (fill in locally; never commit .env)
SUPABASE_URL=
# Publishable/anon key (safe for mobile; backend uses it only to verify nurse tokens)
SUPABASE_ANON_KEY=
# Backend only. Accepts the newer sb_secret_... key or the legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Device auth (the demo wristband)
DEVICE_ID=guardian-001
DEVICE_API_KEY=

# Only honoured outside production; simulated data is always labelled source="simulation"
ALLOW_SIMULATED_DATA=false
# A device counts as online if last_seen_at is newer than this
DEVICE_ONLINE_TIMEOUT_SECONDS=30

# Nurse routes need a Supabase user access token (Authorization: Bearer). Set false only for local poking.
REQUIRE_NURSE_AUTH=true

# DEMO-ONLY alarm rules. Not medical guidance. Warning = yellow, no ringing; critical = red, rings until accepted.
# Heart rate, only while resting (no movement for REST_SECONDS):
#   warning  : outside LOW..HIGH for DURATION;  critical: outside CRITICAL_LOW..CRITICAL_HIGH for CRITICAL_DURATION
DEMO_HR_LOW_BPM=50
DEMO_HR_HIGH_BPM=120
DEMO_HR_DURATION_SECONDS=20
DEMO_HR_CRITICAL_LOW_BPM=45
DEMO_HR_CRITICAL_HIGH_BPM=150
DEMO_HR_CRITICAL_DURATION_SECONDS=15
DEMO_HR_MIN_SAMPLES=3
DEMO_HR_COOLDOWN_SECONDS=60
READING_MAX_SKEW_SECONDS=30

# Skin temperature (warning only): DELTA_C away from the wearer's own baseline (mean of the first
# BASELINE_SAMPLES readings) for DURATION. Lower DURATION for a live demo.
DEMO_TEMP_BASELINE_SAMPLES=60
DEMO_TEMP_DELTA_C=1
DEMO_TEMP_DURATION_SECONDS=300
DEMO_TEMP_MIN_SAMPLES=3
DEMO_TEMP_COOLDOWN_SECONDS=60
# Motion warning (g): peak jerk or peak acceleration from the wristband's 50 Hz IMU (a hand wave stays below these).
# MOTION_AXIS_DELTA_G is only the fallback for sources that report no peaks.
MOTION_AXIS_DELTA_G=0.6
MOTION_JERK_G=3
MOTION_IMPACT_G=3.5
MOTION_COOLDOWN_SECONDS=30
# Fall (critical): an impact, then FALL_STILL_SECONDS (from the impact) without noticeable movement.
# Small movements are ignored; an axis change of FALL_GET_UP_DELTA_G or more cancels the fall. MOVE_DELTA_G only gates "at rest" for heart rate.
# Wristband not worn (no skin contact) / offline (no data) for this long -> yellow warning
NOT_WORN_SECONDS=120
OFFLINE_SECONDS=120
FALL_STILL_SECONDS=10
# A fall also needs free fall or a gravity direction change (2); 1 = impact + stillness alone. Unconfirmed impacts expire.
FALL_MIN_CONFIDENCE=2
FALL_WINDOW_SECONDS=45
# Yellow warnings (sudden motion, warning heart rate, temperature, not worn, offline). false = only red alerts.
WARNING_ALERTS_ENABLED=false
# Free fall (g, below = weightless), get-up move (g per axis), lying-down gravity change (degrees)
FALL_FREEFALL_G=0.4
FALL_GET_UP_DELTA_G=0.4
FALL_ORIENTATION_DEG=45
REST_SECONDS=10
MOVE_DELTA_G=0.15
