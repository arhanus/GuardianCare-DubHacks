{
  "name": "@guardiancare/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_ENV=test node --import tsx --test test/*.test.ts",
    "simulate:sos": "tsx scripts/simulate-sos.ts",
    "replay:telemetry": "tsx scripts/replay-telemetry.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/websocket": "^11.3.4",
    "@guardiancare/contracts": "*",
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
